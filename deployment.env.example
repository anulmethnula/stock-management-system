NODE_ENV=production
STOCKEASY_HOST=127.0.0.1
PORT=3001
COOKIE_SECURE=1

# Used only when the clean production database is created for the first time.
STOCKEASY_ADMIN_USER=admin
STOCKEASY_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Keep the production database outside the released application directory.
STOCKEASY_DB_PATH=/var/lib/stockeasy/stockeasy.db
